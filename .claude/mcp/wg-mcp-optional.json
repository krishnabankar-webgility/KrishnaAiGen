{
  "mcpServers": {
    "atlassian": {
      "command": "node",
      "args": [
        "--env-file",
        "C:/WG-Agentic/wg-ai-workspace/.env",
        "C:/WG-Agentic/wg-ai-workspace/.mcp-servers/run-atlassian-mcp.mjs",
        "uvx",
        "mcp-atlassian"
      ]
    },
    "slack": {
      "command": "node",
      "args": [
        "--env-file",
        "C:/WG-Agentic/wg-ai-workspace/.env",
        "C:/WG-Agentic/wg-ai-workspace/.mcp-servers/run-with-env.mjs",
        "npx",
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "env": {
        "SLACK_TEAM_ID": "T7XA2G1MW"
      }
    },
    "jira": {
      "command": "npx",
      "args": [
        "-y",
        "@nexus2520/jira-mcp-server"
      ],
      "env": {
        "JIRA_EMAIL": "${JIRA_EMAIL}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}",
        "JIRA_BASE_URL": "${JIRA_BASE_URL}"
      }
    },
    "google-workspace": {
      "command": "uvx",
      "args": [
        "workspace-mcp",
        "--single-user",
        "--transport",
        "stdio",
        "--tool-tier",
        "core",
        "--read-only",
        "--tools",
        "gmail",
        "drive",
        "calendar"
      ],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}",
        "USER_GOOGLE_EMAIL": "${USER_GOOGLE_EMAIL}",
        "WORKSPACE_MCP_READ_ONLY": "true"
      }
    }
  }
}